---
import { settings, url } from '../lib/content';
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string; noindex?: boolean }
const { title, description = settings.description, image, noindex = false } = Astro.props;
const pageTitle = title ? title + ' | ' + settings.title : settings.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const section = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
<title>{pageTitle}</title>
<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" /><meta property="og:locale" content="ja_JP" />
<meta property="og:title" content={pageTitle} /><meta property="og:description" content={description} />
<meta property="og:url" content={canonical} /><meta property="og:site_name" content={settings.title} />
{image && <meta property="og:image" content={new URL(url(image),Astro.site)} />}
<meta name="twitter:card" content={image ? 'summary_large_image':'summary'} />
</head>
<body>
<a class="skip" href="#main">本文へスキップ</a>
<header class="site-header wrap">
<a class="brand" href={url('/')} aria-label={settings.title+' ホーム'}><span class="brand-mark" aria-hidden="true">余</span><span>{settings.title}<small>ILLUSTRATION & STORIES</small></span></a>
<nav aria-label="メインナビゲーション">
<a href={url('/')} aria-current={section === url('/') ? 'page':undefined}>作品</a>
<a href={url('/about/')} aria-current={section.includes('/about/') ? 'page':undefined}>プロフィール</a>
<a href={url('/inspiration/')} aria-current={section.includes('/inspiration/') ? 'page':undefined}>参考絵師</a>
</nav>
</header>
<main id="main"><slot /></main>
<footer class="site-footer wrap"><a class="footer-wordmark" href={url('/')}>{settings.title}</a><p>© {new Date().getFullYear()} {settings.copyright}</p></footer>
</body>
</html>
