
---
import Layout from '../layouts/Layout.astro';
import { settings, url } from '../lib/content';
---

<Layout title="プロフィール">
  <section class="text-page wrap">
    <div class="section-heading">
      <h2 id="works-heading">プロフィール</h2>
    </div>
    <div class="about-layout">
      <div class="profile-symbol" aria-hidden="true">
        <span>線</span>
        <span>色</span>
        <span>物語</span>
      </div>

      <div>
        <h2>{settings.name}</h2>

        <p class="prose">
          {settings.bio}
        </p>

        {settings.tools && (
          <div class="info-row">
            <h3>制作環境</h3>
            <p>{settings.tools}</p>
          </div>
        )}

        {(settings.email || settings.socialUrl) && (
          <div class="info-row">
            <h3>リンク・お問い合わせ</h3>

            <div class="contact-links">
              {settings.socialUrl && (
                <a
                  class="text-link"
                  href={settings.socialUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Xのプロフィール ↗
                </a>
              )}

              {settings.email && (
                <a
                  class="text-link"
                  href={'mailto:' + settings.email}
                >
                  メールで連絡する ↗
                </a>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
