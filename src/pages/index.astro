
---
import Layout from '../layouts/Layout.astro';
import { works, url, formatDate } from '../lib/content';

const tags = [...new Set(works.flatMap(work => work.tags))];
---

<Layout image={works[0]?.cover.src}>
  <section class="works-section wrap" aria-labelledby="works-heading">
    <div class="section-heading">
      <h2 id="works-heading">作品一覧</h2>
      <span class="work-count" id="result-count" aria-live="polite">
        {works.length} WORKS
      </span>
    </div>

    <div class="toolbar" id="filters" hidden>
      <div class="filter-buttons" role="group" aria-label="タグで絞り込む">
        <button class="filter active" data-tag="" aria-pressed="true">
          すべて
        </button>
        {tags.map(tag => (
          <button class="filter" data-tag={tag} aria-pressed="false">
            {tag}
          </button>
        ))}
      </div>

      <label class="search">
        <span aria-hidden="true">⌕</span>
        <span class="sr-only">作品を検索</span>
        <input
          id="search"
          type="search"
          placeholder="作品を検索"
          autocomplete="off"
        />
      </label>
    </div>

    <div class="work-grid">
      {works.map((work, index) => (
        <article
          class="work-card"
          data-tags={JSON.stringify(work.tags)}
          data-search={[work.title, work.description, ...work.tags]
            .join(' ')
            .toLocaleLowerCase('ja')}
        >
          <a href={url(`/works/${work.slug}/`)}>
            <div class="art-frame">
              <img
                src={url(work.cover.thumb)}
                alt={work.title}
                width={work.cover.width}
                height={work.cover.height}
                loading={index < 3 ? 'eager' : 'lazy'}
                decoding="async"
              />
              {work.images.length > 1 && (
                <span class="page-badge">{work.images.length} pages</span>
              )}
              {work.featured && (
                <span class="featured-badge">SELECTED</span>
              )}
              <span class="view-art" aria-hidden="true">作品を見る ↗</span>
            </div>

            <div class="card-meta">
              <span>{work.tags.join(' / ') || '作品'}</span>
              <time datetime={work.date}>{formatDate(work.date)}</time>
            </div>

            <h3>
              {work.title}
              <span aria-hidden="true">↗</span>
            </h3>
          </a>
        </article>
      ))}
    </div>

    <p class="empty" id="empty" hidden={works.length > 0}>
      {works.length
        ? '条件に合う作品はありません。検索語やタグを変更してください。'
        : '作品は準備中です。公開まで、もうしばらくお待ちください。'}
    </p>
  </section>
</Layout>

<script>
  const controls = document.querySelector<HTMLElement>('#filters')!;
  const search = document.querySelector<HTMLInputElement>('#search')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.work-card')];
  const resultCount = document.querySelector<HTMLElement>('#result-count')!;
  const empty = document.querySelector<HTMLElement>('#empty')!;

  controls.hidden = false;

  let selected = '';

  function filter() {
    const query = search.value.trim().toLocaleLowerCase('ja');
    let count = 0;

    for (const card of cards) {
      const tags = JSON.parse(card.dataset.tags || '[]') as string[];
      const show =
        (!selected || tags.includes(selected)) &&
        (!query || (card.dataset.search || '').includes(query));

      card.hidden = !show;
      if (show) count++;
    }

    resultCount.textContent = `${count} WORKS`;
    empty.hidden = count > 0;
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      selected = button.dataset.tag || '';

      for (const item of buttons) {
        const active = item === button;
        item.classList.toggle('active', active);
        item.setAttribute('aria-pressed', String(active));
      }

      filter();
    });
  }

  search.addEventListener('input', filter);
</script>
