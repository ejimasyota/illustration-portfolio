---
import Layout from '../layouts/Layout.astro';
import { settings, works, url, formatDate } from '../lib/content';
const tags = [...new Set(works.flatMap(w=>w.tags))];
---
<Layout image={works[0]?.cover.src}>
<section class="hero wrap"><div><p class="eyebrow"><span></span> PERSONAL PORTFOLIO</p><h1>{settings.tagline}</h1><p class="hero-description">{settings.description}</p></div><div class="hero-note"><span>Selected works</span><strong>線、色、物語。</strong><small>ひとつずつ、大切に。</small></div></section>
<section class="works-section wrap" aria-labelledby="works-heading">
<div class="section-heading"><h2 id="works-heading">作品<span>Works</span></h2><span class="work-count" id="result-count" aria-live="polite">{works.length} WORKS</span></div>
<div class="toolbar" id="filters" hidden>
<div class="filter-buttons" role="group" aria-label="タグで絞り込む"><button class="filter active" data-tag="" aria-pressed="true">すべて</button>{tags.map(tag=><button class="filter" data-tag={tag} aria-pressed="false">{tag}</button>)}</div>
<label class="search"><span aria-hidden="true">⌕</span><span class="sr-only">作品を検索</span><input id="search" type="search" placeholder="作品を検索" autocomplete="off" /></label>
</div>
<div class="work-grid">
{works.map((work,index)=><article class="work-card" data-tags={JSON.stringify(work.tags)} data-search={[work.title,work.description,...work.tags].join(' ').toLocaleLowerCase('ja')}>
<a href={url('/works/'+work.slug+'/')}><div class="art-frame"><img src={url(work.cover.thumb)} alt={work.title} width={work.cover.width} height={work.cover.height} loading={index<3?'eager':'lazy'} decoding="async" />{work.images.length>1&&<span class="page-badge">{work.images.length} pages</span>}{work.featured&&<span class="featured-badge">SELECTED</span>}<span class="view-art" aria-hidden="true">作品を見る ↗</span></div><div class="card-meta"><span>{work.tags.join(' / ') || '作品'}</span><time datetime={work.date}>{formatDate(work.date)}</time></div><h3>{work.title}<span aria-hidden="true">↗</span></h3></a>
</article>)}
</div>
<p class="empty" id="empty" hidden={works.length>0}>{works.length?'条件に合う作品はありません。検索語やタグを変更してください。':'作品は準備中です。公開まで、もうしばらくお待ちください。'}</p>
</section>
</Layout>
<script>
const controls=document.querySelector<HTMLElement>('#filters')!;
controls.hidden=false;
let selected='';
const search=document.querySelector<HTMLInputElement>('#search')!;
const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-tag]')];
const cards=[...document.querySelectorAll<HTMLElement>('.work-card')];
function filter(){
 const query=search.value.trim().toLocaleLowerCase('ja');
 let count=0;
 for(const card of cards){
  const tags=JSON.parse(card.dataset.tags||'[]') as string[];
  const show=(!selected||tags.includes(selected))&&(!query||(card.dataset.search||'').includes(query));
  card.hidden=!show;if(show)count++;
 }
 document.querySelector('#result-count')!.textContent=count+' WORKS';
 (document.querySelector('#empty') as HTMLElement).hidden=count>0;
}
for(const button of buttons)button.addEventListener('click',()=>{
 selected=button.dataset.tag||'';
 for(const item of buttons){item.classList.toggle('active',item===button);item.setAttribute('aria-pressed',String(item===button));}
 filter();
});
search.addEventListener('input',filter);
</script>
